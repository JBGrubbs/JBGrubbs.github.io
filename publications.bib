@article{nagy_does_2025,
  abstract = {This study examined the relationships between symptoms of post-traumatic stress (PTS), compulsive sexual behavior (CSB), and problematic pornography use (PPU) while investigating the moderating roles of two types of lifetime trauma experiences (sexual, physical injury-related, and their combination) and gender. Using data from 2,900 American adults (52.5\% men, 45.2\% women, and 2.3\% gender-diverse individuals), we conducted moderated linear regressions to test whether the PTS-CSB and PTS-PPU relationships varied by trauma type and gender. Findings indicated that PTS significantly and positively predicted both CSB and PPU. Originally, trauma type did not significantly moderate the PTS-CSB relationship, only the PTS-PPU relationship. However, a sensitivity analysis revealed a significant moderating effect of sexual trauma on both associations. Contrary to our hypothesis, individuals with sexual-only trauma and higher PTS indicated lower CSB/PPU scores than those with physical injury-related trauma, combined trauma, or no trauma, suggesting that sexual-only trauma may also be linked with sexual avoidance in some individuals. Gender moderated the associations, with men exhibiting higher CSB and PPU scores than women in the presence of higher levels of PTS. Implications and recommendations for future research are discussed.},
  author = {Nagy, Léna and Bőthe, Beáta and Kraus, Shane W. and Demetrovics, Zsolt and Grubbs, Joshua B.},
  doi = {10.1080/10720162.2025.2511324},
  journal = {Sexual Health \& Compulsivity},
  month = {May},
  pages = {1--22},
  title = {Does the {Sexual} {Nature} of {Trauma} {Moderate} the {Relationship} {Between} {Post}-{Traumatic} {Stress} and {Compulsive} {Sexual} {Behaviors}? {Investigating} {Trauma} {Experiences} in the {Light} of {Compulsive} {Sexual} {Behavior} and {Problematic} {Pornography} {Use}},
  url = {https://www.tandfonline.com/doi/full/10.1080/10720162.2025.2511324},
  year = {2025}
}

@article{nagy_sexual_2025,
  abstract = {Sexual assertiveness (SA) is an important concept in understanding sexual well-being and decision-making. However, psychometric evaluation of existing measures of SA in diverse populations is largely lacking, hindering cross-cultural and comparative studies. This study validated the short version of the Sexual Assertiveness Questionnaire (SAQ-9) and examined its measurement invariance across several languages, countries, genders, sexual orientations, and relationship statuses among 65,448 sexually-active adults (Mage = 32.98 years, SD = 12.08, 58\% women, 2.74\% gender-diverse individuals) taking part in the International Sex Survey. The scale demonstrated adequate psychometric properties. Measurement invariance tests indicated that the SAQ-9 is suitable for comparing individuals from different cultures, genders, sexual orientations, and relationship statuses, and significant group differences were also noted (e.g., gender-diverse individuals reported the highest levels of SA). Findings suggest that the SAQ-9 is a reliable and valid measure of SA and appropriate for use in diverse populations, with specific populations exhibiting varying levels of SA.},
  author = {Nagy, Léna and Koós, Mónika and Kraus, Dr. Shane W. and Demetrovics, Zsolt and Potenza, Marc N. and Ballester-Arnal, Rafael and Batthyány, Dominik and Bergeron, Sophie and Billieux, Joël and Briken, Peer and Burkauskas, Julius and Cárdenas-López, Georgina and Carvalho, Joana and Castro-Calvo, Jesús and Chen, Lijun and Chen, Ji-Kang and Ciocca, Giacomo and Corazza, Ornella and Csako, Rita and Fernandez, David P. and Fujiwara, Hironobu and Fernandez, Elaine F. and Fuss, Johannes and Gabrhelík, Roman and Gewirtz-Meydan, Ateret and Gjoneska, Biljana and Gola, Mateusz and Grubbs, Joshua B. and Hashim, Hashim T. and Islam, Md. Saiful and Ismail, Mustafa and Jiménez-Martínez, Martha C. and Jurin, Tanja and Kalina, Ondrej and Klein, Verena and Költő, András and Lee, Sang-Kyu and Lewczuk, Karol and Lin, Chung-Ying and Lochner, Christine and López-Alvarado, Silvia and Lukavská, Kateřina and Mayta-Tristán, Percy and Miller, Dan J. and Orosová, Oľga and Orosz, Gábor and Ponce, Fernando P. and Quintana, Gonzalo R. and Quintero Garzola, Gabriel C. and Ramos-Diaz, Jano and Rigaud, Kévin and Rousseau, Ann and De Tubino, Scanavino Marco and Schulmeyer, Marion K. and Sharan, Pratap and Shibata, Mami and Shoib, Sheikh and Sigre-Leirós, Vera and Sniewski, Luke and Spasovski, Ognen and Steibliene, Vesta and Stein, Dan J. and Strizek, Julian and Štulhofer, Aleksandar and Ünsal, Banu C. and Vaillancourt-Morel, Marie-Pier and Claire Van Hout, Marie and Bőthe, Beáta},
  doi = {10.1177/10731911241312757},
