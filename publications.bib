@article{grubbs_cyber-pornography_2010,
  abstract = {Internet pornography usage has become widespread in recent years, and the task of assessing this usage has proven difficult. Furthermore, assessing this usage in religious populations has proven nearly impossible due to the morally charged nature of the subject. As such, this study recounts the development of a new instrument for assessing Internet pornography usage that could be effectively used in religious populations. Factor analyses of the instrument revealed a three-factor structure that demonstrated acceptable reliability (α {\textgreater}.80) for each factor, as well as some measure of construct validity. The instrument also offered initial analyses of the feelings of guilt and distress experienced by religious populations as a result of their Internet pornography consumption. These results demonstrate great potential for future clinical application as well as research, particularly in populations that are prone to experience more guilt as a result of their usage.},
  author = {Grubbs, Joshua B. and Sessoms, John and Wheeler, Dana M. and Volk, Fred},
  doi = {10.1080/10720161003776166},
  journal = {Sexual Addiction \& Compulsivity},
  month = {January},
  number = {2},
  pages = {106--126},
  title = {The {Cyber}-{Pornography} {Use} {Inventory}: {The} development of a new assessment instrument},
  url = {http://dx.doi.org/10.1080/10720161003776166},
  volume = {17},
  year = {2010}
}

@article{grubbs_dual-level_2026,
  abstract = {Research regarding compulsive sexual behavior disorder has expanded rapidly, yet controversy remains concerning the role of moral evaluations in shaping perceptions of behavioral addiction. This study evaluated the longitudinal relationships between moral disapproval of pornography, pornography use frequency, and problematic pornography use (PPU) at both between-person and within-person levels. Data were collected over five waves (2 years) from a large community sample of American adults (N = 4,363); analyses were restricted to those who contributed at least one active-use wave (N = 7,512 person-waves from 2,903 individuals). Using a multilevel modeling approach, results at the between-person level indicated that moral disapproval was negatively associated with use frequency but positively associated with PPU and that the interaction of disapproval and frequency was a significant predictor of PPU. At the within-person level, we did not find evidence for a purely within-person effect of moral incongruence (e.g., state pornography-viewing frequency and disapproval did not interact to predict PPU), but we did find clear evidence for a cross-level interaction. Trait moral disapproval interacts with within-person, within-time point deviations in pornography use frequency to predict greater levels of PPU. Collectively, these findings suggest that while moral disapproval may serve as a population-level barrier to pornography use, it functions as a specific risk factor for self-reported feelings of addiction among individuals who use pornography, particularly during periods when they experience relatively higher levels of use. Our results also underscore that behavioral frequency is an insufficient metric for assessing sexual dysregulation and must be interpreted within the context of an individual’s moral evaluations. Clinically, these findings emphasize the necessity of diagnostic precision to differentiate moral incongruence from genuine behavioral dysregulation in the assessment and treatment of compulsive sexual behavior disorder and PPU. (PsycInfo Database Record (c) 2026 APA, all rights reserved)},
  address = {US},
  author = {Grubbs, Joshua B. and Floyd, Christopher G. and Carrasquillo, Kristiana D. and Kraus, Shane W.},
  doi = {10.1037/abn0001190},
  journal = {Journal of Psychopathology and Clinical Science},
  publisher = {American Psychological Association},
  title = {The dual-level dynamics of moral incongruence: {A} multilevel analysis of problematic pornography use},
  year = {2026}
}

@article{grubbs_emerging_2019,
  abstract = {Both academic and popular literatures have repeatedly contended that emerging adults are the most narcissistic and entitled age-group in modern times. Although this contention is fiercely debated, the message that emerging adults are narcissistic and entitled has saturated popular culture. Despite this saturation, relatively little empirical work has examined how emerging adults might react to such labels. Across three studies in five samples in the U.S., the present work sought to address this deficit in research. Results from cross-sectional samples of university students at two universities, as well as an online convenience sample of web-using adults (Study 1), indicated that emerging adults believe their agegroup and the one following them (e.g., adolescents) to be the most narcissistic and entitled age-groups, that they have generally negative opinions of narcissism and entitlement, and that they respond negatively to being labeled as narcissistic and entitled. Additionally, results from adult web-users revealed that, while all age groups tend to view adolescents and emerging adults as more narcissistic and entitled than older age-groups, these opinions are more exaggerated among members of older age-groups. Finally, across two experimental studies (Studies 2 \& 3), results indicated that emerging adults react negatively to labeling of their age-group as narcissistic and entitled, but no more negatively than they do to potentially related undesirable labels (e.g., oversensitive). Collectively, these results indicate that emerging adults are aware of and somewhat distressed by messaging that casts their agegroup as the most narcissistic and entitled age-group ever.},
  author = {Grubbs, Joshua B and Exline, Julie J. and McCain, Jessica and Campbell, W. Keith and Twenge, Jean M.},
  doi = {10.1371/journal.pone.0215637},
  editor = {Yechiam, Eldad},
  journal = {PLOS ONE},
  month = {February},
  number = {5},
  pages = {e0215637},
  title = {Emerging adult reactions to labeling regarding age-group differences in narcissism and entitlement},
  url = {http://dx.plos.org/10.1371/journal.pone.0215637},
  volume = {14},
  year = {2019}
}

