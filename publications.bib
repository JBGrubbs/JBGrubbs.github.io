  title = {Sexual {Assertiveness} {Across} {Cultures}, {Genders}, and {Sexual} {Orientations}: {Validation} of the {Short} {Sexual} {Assertiveness} {Questionnaire} ({SAQ}-9)},
  url = {https://journals.sagepub.com/action/showAbstract},
