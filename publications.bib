  month = {April},
  pages = {183--191},
  publisher = {Springer International Publishing},
  title = {Generational {Differences} in {Narcissism} and {Narcissistic} {Traits}},
  url = {http://link.springer.com/10.1007/978-3-319-92171-6_20},
  year = {2018}
}

