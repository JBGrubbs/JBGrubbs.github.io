@article{floyd_context_2022,
  abstract = {Purpose of the Review  Pornography use itself and research related to pornography use remain controversial topics, due in large part to the morally charged subject matter. Given the historical relationship between religion and sexual morality, an argument could be made for attributing some of the contemporary increases in empirical attention to pornography, and thus some of the most substantial advances in research regarding its effects, to public outcry or moral panic. Due to a general lack of consensus among pornography researchers and contrasting findings regarding the potential for pornography use to be problematic or addictive, the last 5 years of pornography research is marked by increased attention to the impact of context and individual differences when assessing pornography use effects. Particularly, researchers have provided compelling evidence that differences in religious and moral values regarding sexual behavior can impact estimates of pornography use and perceptions regarding the problematic or addictive nature of pornography. Considering recent findings, a systematic review of recent research (within the past 5 years) on how religion and morality shape pornography use effects was conducted, with a particular focus on findings regarding pornography problems due to moral incongruence.},
  author = {Floyd, Christopher G. and Grubbs, Joshua B.},
  doi = {10.1007/s11930-022-00329-8},
  journal = {Current Sexual Health Reports},
  title = {Context {Matters}: {How} {Religion} and {Morality} {Shape} {Pornography} {Use} {Effects}},
  url = {https://link.springer.com/10.1007/s11930-022-00329-8},
  year = {2022}
}

@article{floyd_gambling_2024,
  abstract = {The influence of socioeconomic status (SES) on risk of Problem Gambling (PG) is complex, particularly given recent evidence that SES should be understood in both objective and subjective terms. Likewise, financial gambling motives have been found to be predictive of PG; however, financial motives are less understood in comparison to other gambling motives. Preliminary findings on SES and gambling points towards a pattern of social inequality in which those with the least financial resources (e.g., income) or that feel financially deprived relative to others (e.g., perceived deprivation) experience greater harm and problems. In a weighted, census matched sample of adults in the U.S. (N = 1,348), the present study examined the interaction between financial gambling motives and income and financial gambling motives and perceived deprivation in predicting PG. Findings provided support for both financial gambling motives and perceived deprivation as robust predictors of PG. Further, results provided unique insights into the role subjective economic standing may play in the relationship between financial motives for gambling and risk of PG.},
  author = {Floyd, Christopher G. and Kraus, Shane W. and Grubbs, Joshua B.},
  doi = {10.1007/s10899-024-10302-w},
  journal = {Journal of Gambling Studies},
  month = {April},
  title = {Gambling in a {U}.{S}. {Census} {Matched} {Sample}: {Examining} {Interactions} between {Means} and {Motives} in {Predicting} {Problematic} {Outcomes}},
  url = {https://link.springer.com/10.1007/s10899-024-10302-w},
  year = {2024}
}

@article{floyd_lonelyfans_2026,
  abstract = {Subscription-based adult content creator platforms (ACCPs; eg, OnlyFans) represent a rapidly expanding form of computer-mediated sexual media that blends monetized interaction, personalization, and ongoing engagement between users and creators, yet little is known about the psychological correlates of involvement with these platforms over time.To examine longitudinal associations between paid engagement with ACCPs, loneliness, and symptoms of Compulsive Sexual Behavior Disorder (CSBD).Associations between paid engagement with ACCPs, loneliness, and CSBD symptoms were examined in a weighted, census-matched sample of US adults (N = 4363) assessed across five waves over approximately two years in a longitudinal study. At each wave, participants reported frequency of paid engagement with sexual content creators, loneliness, and CSBD symptoms. Parallel process latent growth curve models were used to evaluate baseline associations and co-development over time.Primary outcomes included ACCP engagement frequency, loneliness, and CSBD symptoms assessed across five waves.Parallel process latent growth curve models indicated that higher ACCP engagement was associated with greater CSBD symptoms and, to a lesser extent, loneliness at baseline. Over time, all three variables declined on average; however, their trajectories were significantly linked, such that changes in ACCP engagement corresponded with changes in loneliness and CSBD symptoms.Engagement with ACCPs may represent a clinically relevant context for understanding loneliness and CSBD symptoms, and clinicians may benefit from assessing ACCP engagement when evaluating individuals with concerns related to loneliness or dysregulated sexual behavior, with interventions targeting social disconnection potentially particularly relevant given their co-development over time.Strengths include a large, census-matched US sample and longitudinal data across five waves. Limitations include reliance on self-report measures, a brief measure of loneliness, and a single-item measure of ACCP engagement.These findings suggest that engagement with interactive, subscription-based sexual media is associated with both loneliness and dysregulated sexual behavior over time, highlighting ACCPs as an important context for understanding contemporary patterns of sexual behavior.},
  author = {Floyd, Christopher G and Carrasquillo, Kristiana D and Campbell, London and Connolly, Alexander J and Kraus, Shane W and Grubbs, Joshua B},
  doi = {10.1093/jsxmed/qdag281},
  journal = {The Journal of Sexual Medicine},
  month = {October},
  number = {10},
  pages = {qdag281},
  title = {{LonelyFans}? {Longitudinal} trajectories of adult content subscription platform engagement over two years},
  url = {https://doi.org/10.1093/jsxmed/qdag281},
  volume = {23},
  year = {2026}
}

@article{floyd_motivations_2026,
  abstract = {Gambling disorder and problem gambling are public health problems, and understanding the reasons people gamble and experience problems has critical implications for the functional analysis of problem gambling. This review identiﬁes affect regulation as a central driver of problem gambling and highlights major gaps in current research that must be addressed to improve prevention and treatment efforts.},
  author = {Floyd, Christopher G. and Connolly, Alexander J. and Kraus, Shane W. and Grubbs, Joshua B. and Mick-Keck, Taylor O.},
  doi = {10.1037/adb0001137},
  journal = {Psychology of Addictive Behaviors},
  month = {March},
  title = {Motivations for gambling and problem gambling: {A} systematic review and methodological critique.},
  url = {https://doi.apa.org/doi/10.1037/adb0001137},
  year = {2026}
}

@article{floyd_role_2025,
  abstract = {In comparison to other motives for gambling, social motives (e.g., gambling for social interaction) are often suggested to be the least problematic and, in some cases, even a protective factor for problem gambling. This view is consistent with historical distinctions between ‘social’ versus ‘problem’ gambling. As a result, little research has attempted to identify the circumstances in which social motives are more likely to be associated with risk of problems. Consistent with self-determination theory, the present study examined whether the relationship between social motives and problem gambling varies based on social deficits, such as loneliness and a lack of social connectedness, in a weighted, census matched sample of adults in the U.S. (N = 2,835). Findings demonstrate support for the moderating influence of social deficits (i.e., loneliness and relatedness frustration) on the relationship between social gambling motives and problem gambling and provide unique insights into the circumstances in which social motives are more likely associated with gambling problems.},
  author = {Floyd, Christopher G and Connolly, Alexander J and Tahk, Regina K and Stall, M and Kraus, Shane W and Grubbs, Joshua B},
  doi = {10.1007/s10899-025-10374-2},
  journal = {Journal of Gambling Studies},
  title = {The {Role} of {Social} {Deficits} in the {Link} {Between} {Social} {Gambling} {Motives} and {Problem} {Gambling}},
  year = {2025}
}

@article{fournier_evaluating_2025,
  abstract = {The UPPS-P Impulsive Behavior Model and the various psychometric instruments developed and validated based on this model are well established in clinical and research settings. However, evidence regarding the psychometric validity, reliability, and equivalence across multiple countries of residence, languages, or gender identities, including gender-diverse individuals, is lacking to date. Using data from the International Sex Survey (            N             = 82,243), confirmatory factor analyses and measurement invariance analyses were performed on the preestablished five-factor structure of the 20-item short version of the UPPS-P Impulsive Behavior Scale to examine whether (a) psychometric validity and reliability and (b) psychometric equivalence hold across 34 country-of-residence-related, 22 language-related, and three gender-identity-related groups. The results of the present study extend the latter psychometric instrument’s well-established relevance to 26 countries, 13 languages, and three gender identities. Most notably, psychometric validity and reliability were evidenced across nine novel translations included in the present study (i.e., Croatian, English, German, Hebrew, Korean, Macedonian, Polish, Portuguese—Portugal, and Spanish—Latin American) and psychometric equivalence was evidenced across all three gender identities included in the present study (i.e., women, men, and gender-diverse individuals).},
  author = {Fournier, Loïs and Bőthe, Beáta and Demetrovics, Zsolt and Koós, Mónika and Kraus, Shane W. and Nagy, Léna and Potenza, Marc N. and Ballester-Arnal, Rafael and Batthyány, Dominik and Bergeron, Sophie and Briken, Peer and Burkauskas, Julius and Cárdenas-López, Georgina and Carvalho, Joana and Castro-Calvo, Jesús and Chen, Lijun and Ciocca, Giacomo and Corazza, Ornella and Csako, Rita I. and Fernandez, David P. and Fujiwara, Hironobu and Fernandez, Elaine F. and Fuss, Johannes and Gabrhelík, Roman and Gewirtz-Meydan, Ateret and Gjoneska, Biljana and Gola, Mateusz and Grubbs, Joshua B. and Hashim, Hashim T. and Saiful Islam, Md. and Ismail, Mustafa and Jiménez-Martínez, Martha C. and Jurin, Tanja and Kalina, Ondrej and Klein, Verena and Költő, András and Lee, Sang-Kyu and Lewczuk, Karol and Lin, Chung-Ying and Lochner, Christine and López-Alvarado, Silvia and Lukavská, Kateřina and Mayta-Tristán, Percy and Miller, Dan J. and Orosová, Oľga and Orosz, Gábor and Ponce, Fernando P. and Quintana, Gonzalo R. and Quintero Garzola, Gabriel C. and {Sungkyunkwan University Research Team} and Ramos-Diaz, Jano and Rigaud, Kévin and Rousseau, Ann and De Tubino Scanavino, Marco and Schulmeyer, Marion K. and Sharan, Pratap and Shibata, Mami and Shoib, Sheikh and Sigre-Leirós, Vera and Sniewski, Luke and Spasovski, Ognen and Steibliene, Vesta and Stein, Dan J. and Strizek, Julian and Tsai, Meng-Che and Ünsal, Berk C. and Vaillancourt-Morel, Marie-Pier and Van Hout, Marie Claire and Billieux, Joël},
  doi = {10.1177/10731911241259560},
  journal = {Assessment},
  month = {July},
  number = {5},
